{
  "name": "eyeball",
  "displayName": "Eyeball: Parquet and SQLite Viewer",
  "description": "Fast viewer for large Parquet files and SQLite databases. Scroll through millions of rows and thousands of columns; only what is on screen is read.",
  "version": "0.1.0-dev",
  "publisher": "jurgjn",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/jurgjn/eyeball"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Data Science",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "parquet",
    "sqlite",
    "data viewer",
    "table",
    "dataframe",
    "database"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Files outside the local file system are read into memory in full."
    }
  },
  "activationEvents": [
    "onCustomEditor:eyeball.parquet",
    "onCustomEditor:eyeball.sqlite",
    "onCommand:eyeball.openFile",
    "onCommand:eyeball.openWith"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "eyeball.parquet",
        "displayName": "Eyeball Parquet Viewer",
        "selector": [
          {
            "filenamePattern": "*.parquet"
          },
          {
            "filenamePattern": "*.parq"
          },
          {
            "filenamePattern": "*.pq"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "eyeball.sqlite",
        "displayName": "Eyeball SQLite Viewer",
        "selector": [
          {
            "filenamePattern": "*.sqlite"
          },
          {
            "filenamePattern": "*.sqlite3"
          },
          {
            "filenamePattern": "*.db"
          },
          {
            "filenamePattern": "*.db3"
          },
          {
            "filenamePattern": "*.s3db"
          },
          {
            "filenamePattern": "*.sl3"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "eyeball.openFile",
        "title": "Open Parquet File or SQLite Database...",
        "category": "Eyeball"
      },
      {
        "command": "eyeball.openWith",
        "title": "Open with Eyeball",
        "category": "Eyeball"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "eyeball.openWith",
          "when": "resourceExtname =~ /^\\.(parquet|parq|pq|sqlite|sqlite3|db|db3|s3db|sl3)$/i",
          "group": "navigation@99"
        }
      ],
      "commandPalette": [
        {
          "command": "eyeball.openWith",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Eyeball",
      "properties": {
        "eyeball.cacheSizeMB": {
          "type": "number",
          "default": 512,
          "minimum": 64,
          "description": "Memory budget in MB for decoded Parquet pages, shared by all open files."
        },
        "eyeball.maxCellChars": {
          "type": "number",
          "default": 300,
          "minimum": 20,
          "description": "Values longer than this are truncated in the grid. The full value is shown in the cell detail panel and copied to the clipboard."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p webview",
    "test": "node esbuild.mjs && node test/check.mjs",
    "package": "node esbuild.mjs --production && vsce package --no-dependencies",
    "vscode:prepublish": "node esbuild.mjs --production"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "1.75.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "hyparquet": "1.33.1",
    "hyparquet-compressors": "1.1.3",
    "typescript": "^7.0.2"
  }
}
